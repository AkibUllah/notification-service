APP_ENV=development
LOG_LEVEL=INFO

# SQLite for local dev; PostgreSQL in docker-compose
DATABASE_URL=sqlite:///./notifications.db
# DATABASE_URL=postgresql+psycopg://notify:notify@db:5432/notify

# Admin API key for tenant management and ops endpoints (X-API-Key). Tenants get their own keys.
ADMIN_API_KEY=change-me

# Worker: in-process asyncio loop (true) or run `python -m notifications.worker` separately (false)
WORKER_ENABLED=true
WORKER_POLL_SECONDS=2
WORKER_BATCH_SIZE=50
# Seconds to wait before retry 1..N (last value repeats); dead letter after MAX_ATTEMPTS
RETRY_SCHEDULE_SECONDS=30,120,600,1800
MAX_ATTEMPTS=5
DIGEST_SWEEP_SECONDS=30

# Per-tenant default rate limit for POST /v1/notifications
DEFAULT_RATE_LIMIT_PER_MINUTE=600
DEFAULT_TIMEZONE=Asia/Dhaka
DEFAULT_LOCALE=en

# Provider chains per channel, first = preferred, the rest are fallbacks.
#   email: console | smtp         sms: console | bd_sms         push: file | fcm
EMAIL_PROVIDERS=console
SMS_PROVIDERS=console
PUSH_PROVIDERS=file
PUSH_FILE_PATH=./push-outbox.jsonl
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_COOLDOWN_SECONDS=60

# SMTP stub (needs the `smtp` extra: pip install -e ".[smtp]")
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Bangladesh SMS aggregator stub (HTTP). No real provider is wired; the request shape is illustrative.
BD_SMS_API_URL=
BD_SMS_API_KEY=
BD_SMS_SENDER_ID=

# FCM HTTP v1 stub
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=

# Base URL used in unsubscribe links embedded in templates
PUBLIC_BASE_URL=http://localhost:8000
WEBHOOK_TIMEOUT_SECONDS=5
